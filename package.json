{
  "name": "zencine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:webos": "npm run build && npx -p @webosose/ares-cli ares-package --no-minify ./dist -o ./release",
    "build:apk": "npm run build && npx cap sync android && cd android && .\\gradlew assembleDebug && cd .. && powershell -Command \"Copy-Item android\\app\\build\\outputs\\apk\\debug\\app-debug.apk release\\ZenCine-AndroidTV.apk\"",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.3",
    "@capacitor/screen-orientation": "^8.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "artplayer": "^5.4.0",
    "hls.js": "^1.7.3",
    "lucide-react": "^1.55.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
